type VentaItem {
    id:ID!
    sucursalId: Int
    venta: Venta
    producto: Producto
    presentacion: Presentacion
    cantidad: Float
    precioCosto: Float
    precioVenta: PrecioPorSucursal
    precio: Float
    valorDescuento: Float
    unidadMedida: UnidadMedida
    creadoEn: Date
    usuario: Usuario
    valorTotal: Float
    activo: Boolean
}

input VentaItemInput {
    id:ID
    ventaId: Int
    productoId: Int
    productoDescripcion: String
    presentacionId: Int
    presentacionDescripcion: String
    cantidad: Float
    precioCosto: Float
    precioVentaId: Int
    precio: Float
    valorDescuento: Float
    usuarioId: Int
    sucursalId: Int
    activo: Boolean
    # Lotes elegidos a mano por el cajero. Omitir o mandar vacio = FEFO puro, que es el camino de
    # casi todas las ventas. No se persiste: solo sesga la asignacion, y el registro real de que
    # salio de cada lote queda en el ledger operaciones.movimiento_stock_lote.
    lotes: [VentaItemLoteInput]
}

# Lote elegido a mano para un item de venta. La cantidad va EN UNIDADES BASE, la misma unidad que
# muestra el selector del POS y en la que vive el ledger: no hay conversion en el medio.
input VentaItemLoteInput {
    loteId: ID
    cantidad: Float
}

extend type Query {
    ventaItem(id:ID!, sucId: ID):VentaItem
    ventaItems(page:Int = 0, size:Int = 10, sucId: ID):[VentaItem]!
    countVentaItem: Int
    ventaItemListPorVentaId(id:ID!, sucId: ID):[VentaItem]
}

extend type Mutation {
    saveVentaItem(entity:VentaItemInput!):VentaItem!
    deleteVentaItem(id:ID!, sucId: ID):Boolean!
}


