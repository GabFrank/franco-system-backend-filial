# Impresion del POS desde el cliente: el filial genera el comprobante en ESC/POS (base64) y el
# desktop lo imprime en su impresora local. Cada tipo reproduce la reimpresion que ya existe.
# Ver docs/impresion-pos-desde-cliente.md.
enum TicketEscposTipo {
    VENTA
    FACTURA
    BALANCE
    GASTO
    RETIRO
    DELIVERY
}

extend type Query {
    # id es el de la venta, factura, caja (BALANCE), gasto, retiro o delivery segun el tipo.
    # reimpresion solo cambia GASTO y RETIRO (VENTA y DELIVERY siempre salen como reimpresion).
    ticketEscpos(tipo: TicketEscposTipo!, id: ID!, reimpresion: Boolean, local: String): String
    senaCuponEscpos(input: SenaCuponInput!, local: String): String
}
