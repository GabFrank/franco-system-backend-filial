type Moneda {
    id:ID!
    denominacion: String
    simbolo: String
    pais: Pais
    creadoEn: Date
    usuario: Usuario
    cambio: Float
    monedaBilleteList: [MonedaBilletes]
    activo: Boolean
    principal: Boolean
    decimales: Int
    reglaRedondeo: String
    redondeoMultiplo: Float
}

input MonedaInput {
    id:Int
    denominacion: String
    simbolo: String
    paisId: Int
    usuarioId: Int
    activo: Boolean
    principal: Boolean
    decimales: Int
    reglaRedondeo: String
    redondeoMultiplo: Float
}

extend type Query {
    moneda(id:ID!):Moneda
#    monedaPorPais(paisId:ID): [Moneda]
    monedas(page:Int = 0, size:Int = 10):[Moneda]!
    monedasSearch(texto: String): [Moneda]
    countMoneda: Int
    # Moneda del PDV de esta sucursal (moneda por modulo); sin configuracion, la de la empresa.
    monedaDelPdv: Moneda
    # Moneda configurada para la factura de esta sucursal; null = la moneda de la venta.
    monedaDeFacturacion: Moneda
}

extend type Mutation {

    saveMoneda(moneda:MonedaInput!):Moneda!
    deleteMoneda(id:ID!):Boolean!
}

