extend type Query {
    capturaCupon(token: String!): CapturaCupon
}

extend type Mutation {
    crearCapturaCupon(cajaId: ID!, sucursalId: ID!, usuarioId: ID): CapturaCuponQr
}

extend type Subscription {
    capturaCuponSub: CapturaCuponUpdate
}

# Lo minimo para dibujar el QR. La URL la arma el filial: es el unico que sabe por que
# interfaz lo alcanza un telefono en el wifi del local.
type CapturaCuponQr {
    token: String
    url: String
    expiraEn: String
}

# El aviso que sale cuando el OCR termina: un TIMBRE, no el contenido. El texto del cupon se
# pide con capturaCupon(token), que pasa por login; esta subscription es anonima porque por
# WebSocket no hay sesion. Se emite tambien en ERROR: el cajero mira la caja, no el telefono.
type CapturaCuponUpdate {
    token: String
    cajaId: ID
    estado: String
}

# El estado de una captura, como lo consulta el desktop. Sin el usuario: es dato de auditoria
# de la entidad, y exponer un @ManyToOne lazy en una query fuera de transaccion no vale la pena
# para algo que el desktop ya sabe --el QR lo mostro el.
type CapturaCupon {
    id: ID
    token: String
    sucursalId: ID
    cajaId: ID
    estado: String
    expiraEn: Date
    usadoEn: Date
    imagenUrl: String
    textoOcr: String
    campos: String
    msOcr: Int
    intentos: Int
    nitidez: Float
    error: String
    creadoEn: Date
}
