            <snapshots>
                <enabled>true</enabled>
            </snapshots>
        </repository>
    </repositories>

    <profiles>

        <!-- Desarrollo en macOS.

             El jar podado trae los nativos de linux-x64 y win-x64, que son las dos plataformas
             de la flota de filiales; macOS no esta, y no tiene por que estar: ninguna sucursal
             corre macOS. Pero los desarrolladores si, y sin nativo el motor no carga: queda
             "no disponible" y la captura por foto no se puede probar en local.

             Este perfil se activa solo al compilar en una Mac y agrega el artefacto oficial de
             Microsoft, que trae osx-aarch64 y osx-x64. No afecta a lo que se despliega: el CI y
             los releases corren en Linux, donde el perfil no se activa y el jar sigue pesando
             13,1 MB.

             Los dos artefactos conviven en el classpath en Mac. No hay conflicto: las 58 clases
             de ai.onnxruntime son byte a byte identicas entre los dos (verificado 2026-09-10),
             porque el podado se hizo sacando nativos, sin recompilar nada. Y los nativos no se
             pisan: el podado no trae ninguno de osx. -->
        <profile>
            <id>ocr-mac</id>
            <activation>
                <os><family>mac</family></os>
            </activation>
            <dependencies>
                <dependency>
                    <groupId>com.microsoft.onnxruntime</groupId>
                    <artifactId>onnxruntime</artifactId>
                    <version>1.23.2</version>
                </dependency>
            </dependencies>
        </profile>

    </profiles>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!-- Maven Surefire Plugin - Skip tests -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>2.22.2</version>
                <configuration>
                    <skipTests>false</skipTests>
                </configuration>
            </plugin>

            <!-- Flyway duplicate migration cleanup plugin -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.0.0</version>
                <executions>
                    <execution>
                        <id>cleanup-duplicate-migrations</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>${project.basedir}/cleanup-duplicate-migrations.sh</executable>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!--			<plugin>-->
